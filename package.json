{
  "name": "bare-wasm",
  "version": "0.1.0",
  "description": "WebAssembly JavaScript API for Bare",
  "exports": {
    "./package": "./package.json",
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts"
  ],
  "scripts": {
