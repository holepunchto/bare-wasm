  "bugs": {
    "url": "https://github.com/holepunchto/bare-wasm/issues"
  },
  "homepage": "https://github.com/holepunchto/bare-wasm#readme",
  "devDependencies": {
    "brittle": "^3.5.0",
    "lunte": "^1.8.4",
    "prettier": "^3.4.2",
    "prettier-config-holepunch": "^2.0.0"
  }
}
